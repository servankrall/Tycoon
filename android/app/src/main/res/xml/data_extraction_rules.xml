<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: cloud backup and device-to-device transfer keep the city saves (files/store) -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="store/" />
        <exclude domain="file" path="selftest/" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="store/" />
        <exclude domain="file" path="selftest/" />
    </device-transfer>
</data-extraction-rules>
